{
  "Comment": "00I AWS-I2-EA drift trajectory — design skeleton only; one bounded targeted re-entry",
  "StartAt": "QualifyAndPersistBasis",
  "States": {
    "QualifyAndPersistBasis": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${QualifyAndPersistBasisFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.qualification",
      "Next": "WaitUntilT2"
    },
    "WaitUntilT2": {
      "Type": "Wait",
      "TimestampPath": "$.qualification.Payload.execute_at",
      "Next": "CheckBasisModelCurrent"
    },
    "CheckBasisModelCurrent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${CheckBasisModelCurrentFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.basis_check",
      "Next": "BasisModelCurrent"
    },
    "BasisModelCurrent": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.basis_check.Payload.current",
          "BooleanEquals": true,
          "Next": "GuardCurrentBasis"
        },
        {
          "Variable": "$.basis_check.Payload.current",
          "BooleanEquals": false,
          "Next": "TargetedReentry"
        }
      ],
      "Default": "BasisUnknown"
    },
    "TargetedReentry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${TargetedReentryFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.reentry",
      "Next": "ReentrySucceeded"
    },
    "ReentrySucceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.reentry.Payload.status",
          "StringEquals": "SUPPORTED",
          "Next": "GuardAfterReentry"
        },
        {
          "Variable": "$.reentry.Payload.status",
          "StringEquals": "DBC_DENY",
          "Next": "Denied"
        },
        {
          "Variable": "$.reentry.Payload.status",
          "StringEquals": "DBC_ESCALATE",
          "Next": "Escalated"
        }
      ],
      "Default": "BasisUnknown"
    },
    "GuardCurrentBasis": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AcquireLeaseAndRequalifyFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.guard",
      "Next": "InitialDisposition"
    },
    "InitialDisposition": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.guard.Payload.disposition",
          "StringEquals": "DBC_EXECUTE",
          "Next": "ApplyUnderLease"
        },
        {
          "Variable": "$.guard.Payload.disposition",
          "StringEquals": "DBC_REQUALIFY",
          "Next": "TargetedReentry"
        },
        {
          "Variable": "$.guard.Payload.disposition",
          "StringEquals": "DBC_DENY",
          "Next": "Denied"
        },
        {
          "Variable": "$.guard.Payload.disposition",
          "StringEquals": "DBC_ESCALATE",
          "Next": "Escalated"
        }
      ],
      "Default": "BasisUnknown"
    },
    "GuardAfterReentry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AcquireLeaseAndRequalifyFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.guard_after_reentry",
      "Next": "PostReentryDisposition"
    },
    "PostReentryDisposition": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.guard_after_reentry.Payload.disposition",
          "StringEquals": "DBC_EXECUTE",
          "Next": "ApplyUnderLease"
        },
        {
          "Variable": "$.guard_after_reentry.Payload.disposition",
          "StringEquals": "DBC_DENY",
          "Next": "Denied"
        },
        {
          "Variable": "$.guard_after_reentry.Payload.disposition",
          "StringEquals": "DBC_ESCALATE",
          "Next": "Escalated"
        },
        {
          "Variable": "$.guard_after_reentry.Payload.disposition",
          "StringEquals": "DBC_REQUALIFY",
          "Next": "ReentryBudgetExhausted"
        }
      ],
      "Default": "BasisUnknown"
    },
    "ApplyUnderLease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ApplyUnderLeaseFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.apply_result",
      "Next": "ReleaseLease"
    },
    "ReleaseLease": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReleaseLeaseFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.release_result",
      "End": true
    },
    "Denied": {
      "Type": "Succeed"
    },
    "Escalated": {
      "Type": "Succeed"
    },
    "ReentryBudgetExhausted": {
      "Type": "Fail",
      "Error": "00I.ReentryBudgetExhausted",
      "Cause": "A second requalification request exceeded the skeleton's one-attempt bounded re-entry budget"
    },
    "BasisUnknown": {
      "Type": "Fail",
      "Error": "00I.BasisUnknown",
      "Cause": "Current decision-basis model could not be established inside the admitted path"
    }
  }
}
